{
  "name": "risor-kammermusikkfest",
  "private": true,
  "packageManager": "npm@11.21.3",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11.21.3 <12"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "prepare": "node ./scripts/setup-git-hooks.mjs",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:studio": "cd studio && npm run dev",
    "build": "npm run build --workspace=frontend && npm run build --workspace=studio",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "check-deps": "npm ls",
    "check-deps:root": "npm ls --workspaces=false",
    "outdated:deps": "npm outdated --workspaces --include-workspace-root",
    "audit:deps": "npm audit --workspaces --omit=dev",
    "audit:deps:ci": "npm audit --workspaces --omit=dev --audit-level=high",
    "typegen": "npm run typegen --workspace=studio"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "sanity": "6.25.0",
    "path-to-regexp": "6.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "rollup": "4.61.1",
    "tar": "7.5.22",
    "picomatch": "2.3.2",
    "anymatch@3.1.3": {
      "picomatch": "2.3.2"
    }
  },
  "allowScripts": {
    "@lezer/javascript": true,
    "esbuild": true,
    "sharp": true
  }
}
