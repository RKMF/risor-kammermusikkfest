{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "npm run typecheck && astro build",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "check:astro": "astro check",
    "check:htmx": "node ./scripts/check-htmx.mjs",
    "sync:htmx": "node ./scripts/sync-htmx.mjs",
    "typegen": "echo 'Run npm run typegen from the monorepo root instead' && exit 1",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/vercel": "11.0.22",
    "@portabletext/types": "4.0.2",
    "@sanity/client": "7.22.1",
    "@sanity/image-url": "2.2.0",
    "@sanity/webhook": "4.0.4",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "3.11.3",
    "@vercel/speed-insights": "1.3.1",
    "astro": "7.4.13",
    "astro-portabletext": "0.13.0",
    "groq": "^4.22.0",
    "htmx.org": "2.0.11",
    "styled-components": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@vitest/ui": "4.1.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
